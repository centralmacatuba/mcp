# URL base do gateway da API pública
CM_API_BASE_URL=https://publica.api.centralmacatuba.qzz.io
CM_API_TIMEOUT_MS=20000

# Transporte HTTP (Render, VPS etc.)
PORT=3000
MCP_HTTP_HOST=0.0.0.0
# Hostnames exatos permitidos, separados por vírgula.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp.centralmacatuba.qzz.io
# Origens browser permitidas, separadas por vírgula. Vazio rejeita requisições que enviem Origin.
MCP_ALLOWED_ORIGINS=
